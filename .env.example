# Kopiere diese Datei nach .env.development.local und trage echte Werte ein.
# Nicht .env oder .env.local verwenden: OpenNext übernimmt deren Werte in die
# Production-Konfiguration des Workers. Für Cloudflare siehe README („Cloudflare'e deploy“).

# Stripe (Testmodus: sk_test_...)
STRIPE_SECRET_KEY=sk_test_replace_me

# Öffentliche Basis-URL der Seite, ohne abschließenden Slash
SITE_URL=http://localhost:3000

# Admin-Zugang
ADMIN_PASSWORD=bitte-ein-langes-passwort-waehlen
# Mindestens 32 zufällige Zeichen, z. B. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# E-Mail-Versand (Widerrufsbestätigung) über Resend
RESEND_API_KEY=re_replace_me
MAIL_FROM="everfeier <shop@example.com>"
OPERATOR_EMAIL=you@example.com

# Saison: open | closed
SHOP_MODE=open
# Letzter Bestellzeitpunkt für Lieferung bis Halloween (ISO 8601 mit Zeitzone)
ORDER_CUTOFF=2026-10-28T23:59:00+01:00

# Steuer: kleinunternehmer | regular
VAT_MODE=kleinunternehmer
